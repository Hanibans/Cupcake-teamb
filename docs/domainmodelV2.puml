@startuml
!pragma layout smetana

object Customer
object Order
object OrderLine
object Cupcake
object Base
object Topping
object Payment
object Administrator

Customer "1" - "0..*" Order : places
Order "1" - "1..*" OrderLine : contains
OrderLine "1" -- "1..*" Cupcake : contains
Cupcake "*" -- "1" Base : has
Cupcake "*" -- "1" Topping : has
Order "1" -- "0..1" Payment : paid with
Administrator -- Order : manages
Administrator -- Customer : manages

@enduml
